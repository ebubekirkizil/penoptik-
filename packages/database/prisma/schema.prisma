  RESOLVED
  CLOSED
}

enum CompanyType {
  SAHIS
  LIMITED
  ANONIM
}

enum StockStatus {
  IN_STOCK
  SOLD
  WASTE
}

model FixedTransaction {
  id          String   @id @default(cuid())
  FirmId      String
  type        TxType
  amount      Float
  currency    String   @default("TRY")
  category    String
  description String
  dayOfMonth  Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Firm        Firm     @relation(fields: [FirmId], references: [id], onDelete: Cascade)
}

model WholesalerPurchase {
  id           String         @id @default(cuid())
  FirmId       String
  wholesalerId String
  status       PurchaseStatus @default(PENDING)
  totalAmount  Float
  cargoStatus  CargoStatus    @default(PREPARING)
  trackingNo   String?
  notes        String?
  expectedDate DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  Firm       Firm                     @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  wholesaler Wholesaler               @relation(fields: [wholesalerId], references: [id], onDelete: Cascade)
  items      WholesalerPurchaseItem[]
}

model WholesalerPurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  variantId  String?
  quantity   Int
  unitPrice  Float
  expiryDate DateTime?

  purchase WholesalerPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product            @relation(fields: [productId], references: [id])
  variant  ProductVariant?    @relation(fields: [variantId], references: [id])
}

model WholesalerPayment {
  id           String   @id @default(cuid())
  FirmId       String
  wholesalerId String
  amount       Float
  title        String?
  paymentDate  DateTime @default(now())
  method       TxSource @default(TRANSFER)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  Firm       Firm       @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  wholesaler Wholesaler @relation(fields: [wholesalerId], references: [id], onDelete: Cascade)
}

enum PurchaseStatus {
  PENDING
  DELIVERED
  CANCELLED
}
