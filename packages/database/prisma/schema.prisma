generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model SubscriptionPackage {
  id             String          @id @default(cuid())
  name           String
  description    String?
  price          Float
  currency       String          @default("TRY")
  features       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  firms          Firm[]
  packageModules PackageModule[]
}

model Firm {
  id                    String                     @id @default(cuid())
  name                  String
  email                 String?
  phone                 String?
  address               String?
  isActive              Boolean                    @default(true)
  subscriptionPlan      String                     @default("TRIAL")
  subscriptionEnd       DateTime?
  subscriptionStatus    String                     @default("ACTIVE")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  domain                String?                    @unique
  sector                String                     @default("OPTICS")
  activeModules         String?
  packageId             String?
  isTieredPricing       Boolean                    @default(false)
  maxUsers              Int                        @default(5)
  customPrice           Float?
  tieredPrice           Float?
  trialDays             Int?
  isInventoryActive     Boolean                    @default(false)
  logoUrl               String?
  activeSessions        ActiveSession[]
  addresses             Address[]
  aiUsageLogs           AiUsageLog[]
  analyticsEvents       AnalyticsEvent[]
  auditLogs             AuditLog[]
  b2Bcompanies          B2BCompany[]
  bankAccounts          BankAccount[]
  bankReconciliations   BankReconciliation[]
  bankTransactionRaws   BankTransactionRaw[]
  cargoTrackings        CargoTracking[]
  channelVisibilities   ChannelVisibility[]
  couponUsageLogs       CouponUsageLog[]
  currentAccounts       CurrentAccount[]
  customers             Customer[]
  discountCodes         DiscountCode[]
  dispatches            Dispatch[]
  expenseTags           ExpenseTag[]
  financeAuditLogs      FinanceAuditLog[]
  transactions          FinanceTransaction[]
  financialRecords      FinancialRecord[]
  financialTransactions FinancialTransaction[]
  fixedTransactions     FixedTransaction[]
  package               SubscriptionPackage?       @relation(fields: [packageId], references: [id])
  firmBlocks            FirmBlock[]
  firmModules           FirmModule[]
  firmPages             FirmPage[]
  firmTemplates         FirmTemplate[]
  firmThemes            FirmTheme[]
  fulfillments          Fulfillment[]
  fulfillmentItems      FulfillmentItem[]
  inventoryTransactions InventoryTransaction[]
  invoices              Invoice[]
  kvkkConsentLogs       KvkkConsentLog[]
  navigationItems       NavigationItem[]
  navigationMenus       NavigationMenu[]
  notifications         Notification[]
  orders                Order[]
  orderEventLogs        OrderEventLog[]
  orderItems            OrderItem[]
  packagePresets        PackagePreset[]
  products              Product[]
  productBundles        ProductBundle[]
  productBundleItems    ProductBundleItem[]
  productOptions        ProductOption[]
  productOptionValues   ProductOptionValue[]
  productVariants       ProductVariant[]
  productionOrders      ProductionOrder[]
  rawMaterials          RawMaterial[]
  refunds               Refund[]
  refundItems           RefundItem[]
  reviews               Review[]
  settings              Settings?
  shippingProviders     ShippingProvider[]
  shippingZones         ShippingZone[]
  siteSettings          SiteSettings[]
  stockLedgers          StockLedger[]
  suppliers             Supplier[]
  supportTickets        SupportTicket[]
  systemTransactions    SystemFinanceTransaction[]
  taxOptimizationLogs   TaxOptimizationLog[]
  taxProfile            TaxProfile?
  taxReports            TaxReport[]
  tickets               Ticket[]
  trackingEvents        TrackingEvent[]
  users                 User[]
  warehouses            Warehouse[]
  warehouseStocks       WarehouseStock[]
  Wholesaler            Wholesaler[]
  wholesalerPurchases   WholesalerPurchase[]
  wholesalerPayments    WholesalerPayment[]
  wishlistItems         WishlistItem[]
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  firstName           String?
  lastName            String?
  role                String               @default("FIRM_ADMIN")
  firmId              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  position            String?
  salary              Float?
  totalActiveHours    Float                @default(0)
  sgkTaxRate          Float                @default(20)
  deletedAt           DateTime?
  userCode            String?              @unique
  username            String?              @unique
  frozenReason        String?
  isFrozen            Boolean              @default(false)
  activityLogs        ActivityLog[]
  addresses           Address[]
  b2bContact          B2BCompany?          @relation("B2BUser")
  personalDiscounts   DiscountCode[]       @relation("PersonalDiscount")
  employeeShifts      EmployeeShift[]
  kvkkConsentLogs     KvkkConsentLog[]
  nfcCards            NfcCard[]
  nfcProfile          NfcProfile?
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  payrolls            Payroll[]
  reviews             Review[]
  supportTickets      SupportTicket[]
  tickets             Ticket[]
  firm                Firm?                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  wishlistItems       WishlistItem[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  duration  Int?
  createdAt DateTime @default(now())
  details   Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ticket {
  id        String   @id @default(cuid())
  firmId    String
  userId    String
  subject   String
  message   String
  status    String   @default("OPEN")
  priority  String   @default("NORMAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinanceTransaction {
  id          String    @id @default(cuid())
  firmId      String
  type        String
  amount      Float
  category    String
  description String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  firm        Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
}

model Customer {
  id                  String                 @id @default(cuid())
  firstName           String
  lastName            String
  phone               String
  address             String?
  email               String?
  password            String?
  diseases            String?
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  hasLoggedBefore     Boolean                @default(false)
  isPasswordTemporary Boolean                @default(false)
  tempPasswordExpires DateTime?
  tempPasswordPlain   String?
  firmId              String?
  deletedAt           DateTime?
  tcNo                String?
  firstNameHash       String?
  kvkkApprovedAt      DateTime?
  kvkkApprovedIp      String?
  lastNameHash        String?
  phoneHash           String?                @unique
  tcNoHash            String?
  firm                Firm?                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  verifications       CustomerVerification[]
  opticOrders         OpticOrder[]
  prescriptions       Prescription[]
  @@index([firmId])
}

model CustomerVerification {
  id         String   @id @default(cuid())
  customerId String
  oldData    Json
  newData    Json
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Prescription {
  id               String       @id @default(cuid())
  customerId       String
  farRightSph      String?
  farRightCyl      String?
  farRightAx       String?
  farLeftSph       String?
  farLeftCyl       String?
  farLeftAx        String?
  nearRightSph     String?
  nearRightCyl     String?
  nearRightAx      String?
  nearLeftSph      String?
  nearLeftCyl      String?
  nearLeftAx       String?
  constantRightSph String?
  constantRightCyl String?
  constantRightAx  String?
  constantLeftSph  String?
  constantLeftCyl  String?
  constantLeftAx   String?
  addRight         String?
  addLeft          String?
  lensType         String?
  doctorName       String?
  hospitalName     String?
  notes            String?
  isPending        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  pdLeft           String?
  pdRight          String?
  pdTotal          String?
  phLeft           String?
  phRight          String?
  coating          String?
  deletedAt        DateTime?
  opticOrders      OpticOrder[]
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId])
}

model OpticOrder {
  id             String        @id @default(cuid())
  customerId     String
  prescriptionId String?
  status         String        @default("PENDING")
  products       String?
  productCode    String?
  totalPrice     Float?
  deposit        Float?
  balance        Float?
  orderDate      DateTime      @default(now())
  deliveryDate   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  printSerialNo  String?
  installments   Installment[]
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  @@index([customerId])
  @@index([prescriptionId])
}

model Installment {
  id        String     @id @default(cuid())
  orderId   String
  amount    Float
  dueDate   DateTime
  isPaid    Boolean    @default(false)
  paidAt    DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  order     OpticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Settings {
  id                          String    @id @default(cuid())
  defaultTheme                String    @default("system")
  customerCanViewMeasurements Boolean   @default(true)
  customerCanEditMeasurements Boolean   @default(false)
  customerCanViewBalance      Boolean   @default(true)
  customerCanViewNotes        Boolean   @default(true)
  customerCanViewDoctorInfo   Boolean   @default(true)
  lightPrimary                String?
  lightSecondary              String?
  lightBackground             String?
  lightSurface                String?
  lightForeground             String?
  lightMutedForeground        String?
  lightBorder                 String?
  darkPrimary                 String?
  darkSecondary               String?
  darkBackground              String?
  darkSurface                 String?
  darkForeground              String?
  darkMutedForeground         String?
  darkBorder                  String?
  themeData                   String?   @default("{}")
  subscriptionPlan            String    @default("Temel Paket")
  subscriptionStatus          String    @default("Aktif")
  subscriptionEndDate         DateTime?
  supportLevel                String    @default("Standart E-posta Desteği")
  hardwareSupport             Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  firmId                      String?   @unique
  orderStatusConfig           String?
  lastPrintSequence           Int       @default(0)
  isAiBotActive               Boolean   @default(true)
  firm                        Firm?     @relation(fields: [firmId], references: [id], onDelete: Cascade)
}

model Address {
  id         String   @id @default(cuid())
  FirmId     String
  userId     String
  title      String
  fullName   String
  phone      String
  city       String
  district   String
  postalCode String?
  address    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  Firm       Firm     @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
}

model ChannelVisibility {
  id          String    @id @default(cuid())
  FirmId      String
  productId   String    @unique
  showOnWeb   Boolean   @default(true)
  showOnB2B   Boolean   @default(false)
  showOnPOS   Boolean   @default(false)
  publishAt   DateTime?
  unpublishAt DateTime?
  updatedAt   DateTime  @updatedAt
  Firm        Firm      @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Product {
  id                      String                   @id @default(cuid())
  FirmId                  String
  name                    String
  slug                    String
  description             String
  shortDesc               String?
  price                   Float
  compareAtPrice          Float?
  costPrice               Float?
  category                ProductCategory          @default(OTHER)
  status                  ProductStatus            @default(ACTIVE)
  vendor                  String?                  @default("Davut Kundura Atölyesi")
  tags                    String[]
  imageUrls               String[]
  videoUrl                String?
  modelUrl3D              String?
  sku                     String?
  barcode                 String?
  weight                  Float?
  lowStockAlert           Int                      @default(5)
  trackInventory          Boolean                  @default(true)
  allowBackorder          Boolean                  @default(false)
  seoTitle                String?
  seoDesc                 String?
  seoKeywords             String[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  details                 Json?
  channelVisibility       ChannelVisibility?
  inventory               InventoryTransaction[]
  orderItems              OrderItem[]
  Firm                    Firm                     @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  bundleItems             ProductBundleItem[]      @relation("BundleComponents")
  options                 ProductOption[]
  variants                ProductVariant[]
  productionOrders        ProductionOrder[]
  reviews                 Review[]
  wishlistItems           WishlistItem[]
  wholesalerPurchaseItems WholesalerPurchaseItem[]

  @@unique([FirmId, slug])
  @@unique([FirmId, sku])
}

model ProductBundle {
  id          String              @id @default(cuid())
  FirmId      String
  name        String
  description String?
  price       Float
  imageUrl    String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  Firm        Firm                @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  items       ProductBundleItem[]
}

model ProductBundleItem {
  id        String        @id @default(cuid())
  FirmId    String
  bundleId  String
  productId String
  variantId String?
  quantity  Int           @default(1)
  Firm      Firm          @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product       @relation("BundleComponents", fields: [productId], references: [id])

  @@unique([FirmId, bundleId, productId, variantId])
}

model ProductOption {
  id        String               @id @default(cuid())
  FirmId    String
  productId String
  name      String
  position  Int                  @default(0)
  Firm      Firm                 @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]
}

model ProductOptionValue {
  id               String        @id @default(cuid())
  FirmId           String
  optionId         String
  value            String
  dependsOnValueId String?
  position         Int           @default(0)
  Firm             Firm          @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  option           ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id                      String                   @id @default(cuid())
  FirmId                  String
  productId               String
  name                    String
  size                    String?
  color                   String?
  material                String?
  price                   Float?
  costPrice               Float?
  sku                     String?                  @unique
  barcode                 String?
  stock                   Int                      @default(0)
  imageUrl                String?
  isActive                Boolean                  @default(true)
  orderItems              OrderItem[]
  Firm                    Firm                     @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  product                 Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLedger             StockLedger[]
  warehouseStocks         WarehouseStock[]
  wholesalerPurchaseItems WholesalerPurchaseItem[]
}

model Order {
  id               String          @id @default(cuid())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  FirmId           String
  addressId        String?
  adminNotes       String?
  billingAddressId String?
  discountAmount   Float           @default(0)
  discountCodeId   String?
  dueDate          DateTime?
  notes            String?
  orderNumber      String          @unique
  orderType        OrderType       @default(B2C)
  paidAmount       Float           @default(0)
  paymentStatus    PaymentStatus   @default(UNPAID)
  paytrMerchantOid String?
  paytrToken       String?
  shippingCost     Float           @default(0)
  subtotal         Float
  taxAmount        Float           @default(0)
  totalAmount      Float
  userId           String
  status           OrderStatus     @default(PENDING)
  deletedAt        DateTime?
  customerPay      Float           @default(0)
  sgkPay           Float           @default(0)
  fulfillments     Fulfillment[]
  invoice          Invoice?
  Firm             Firm            @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  address          Address?        @relation(fields: [addressId], references: [id])
  discountCode     DiscountCode?   @relation(fields: [discountCodeId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  eventLogs        OrderEventLog[]
  items            OrderItem[]
  refunds          Refund[]
  supportTickets   SupportTicket[]
  @@index([FirmId])
  @@index([userId])
}

model OrderItem {
  id           String          @id @default(cuid())
  FirmId       String
  orderId      String
  productId    String
  variantId    String?
  quantity     Int
  price        Float
  costPrice    Float?
  taxRate      Float           @default(18)
  discount     Float           @default(0)
  fulfilledQty Int             @default(0)
  refundedQty  Int             @default(0)
  bundleId     String?
  Firm         Firm            @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  @@index([orderId])
  @@index([productId])
}

model Fulfillment {
  id              String            @id @default(cuid())
  FirmId          String
  orderId         String
  warehouseId     String?
  status          FulfillmentStatus @default(PENDING)
  cargoCompany    String?
  cargoTrackingNo String?
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  dispatch        Dispatch?
  Firm            Firm              @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse       Warehouse?        @relation(fields: [warehouseId], references: [id])
  items           FulfillmentItem[]
  @@index([orderId])
}

model FulfillmentItem {
  id            String      @id @default(cuid())
  FirmId        String
  fulfillmentId String
  orderItemId   String
  quantity      Int
  Firm          Firm        @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
}

model Refund {
  id        String       @id @default(cuid())
  FirmId    String
  orderId   String
  amount    Float
  reason    String?
  status    RmaStatus    @default(REQUESTED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  Firm      Firm         @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     RefundItem[]
}

model RefundItem {
  id          String        @id @default(cuid())
  FirmId      String
  refundId    String
  orderItemId String
  quantity    Int
  condition   RmaCondition?
  Firm        Firm          @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  refund      Refund        @relation(fields: [refundId], references: [id], onDelete: Cascade)
}

model OrderEventLog {
  id        String   @id @default(cuid())
  FirmId    String
  orderId   String
  action    String
  message   String
  userId    String?
  ipAddress String?
  createdAt DateTime @default(now())
  Firm      Firm     @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model StockLedger {
  id           String            @id @default(cuid())
  FirmId       String
  variantId    String
  warehouseId  String
  movementType StockMovementType
  quantity     Int
  unitCost     Float?
  reference    String?
  notes        String?
  performedBy  String?
  createdAt    DateTime          @default(now())
  Firm         Firm              @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  variant      ProductVariant    @relation(fields: [variantId], references: [id])
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])

  @@index([variantId, warehouseId])
  @@index([createdAt])
}

model InventoryTransaction {
  id        String            @id @default(cuid())
  FirmId    String
  productId String
  quantity  Int
  type      StockMovementType
  notes     String?
  createdBy String?
  createdAt DateTime          @default(now())
  Firm      Firm              @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id])
}

model ShippingProvider {
  id         String               @id @default(cuid())
  FirmId     String
  name       String
  slug       String               @unique
  type       ShippingProviderType
  logoUrl    String?
  isActive   Boolean              @default(true)
  apiBaseUrl String?
  apiKey     String?
  apiSecret  String?
  webhookUrl String?
  createdAt  DateTime             @default(now())
  dispatches Dispatch[]
  Firm       Firm                 @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  zones      ShippingZone[]
}

model ShippingZone {
  id          String           @id @default(cuid())
  FirmId      String
  providerId  String
  name        String
  countries   String[]
  baseFee     Float            @default(0)
  perDesiRate Float            @default(0)
  currency    String           @default("TRY")
  freeAbove   Float?
  Firm        Firm             @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  provider    ShippingProvider @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

model PackagePreset {
  id            String     @id @default(cuid())
  FirmId        String
  name          String
  widthCm       Float
  heightCm      Float
  depthCm       Float
  emptyWeightKg Float      @default(0)
  dispatches    Dispatch[]
  Firm          Firm       @relation(fields: [FirmId], references: [id], onDelete: Cascade)
}

model Dispatch {
  id               String           @id @default(cuid())
  FirmId           String
  fulfillmentId    String           @unique
  providerId       String
  packagePresetId  String?
  status           DispatchStatus   @default(DRAFT)
  trackingNo       String?          @unique
  trackingUrl      String?
  zplLabel         String?
  pdfLabelUrl      String?
  grossWeightKg    Float?
  desiWeight       Float?
  chargeableWeight Float?
  waybillNo        String?
  shippingCost     Float?
  returnBarcode    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  Firm             Firm             @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  fulfillment      Fulfillment      @relation(fields: [fulfillmentId], references: [id])
  packagePreset    PackagePreset?   @relation(fields: [packagePresetId], references: [id])
  provider         ShippingProvider @relation(fields: [providerId], references: [id])
  trackingEvents   TrackingEvent[]
}

model TrackingEvent {
  id          String   @id @default(cuid())
  FirmId      String
  dispatchId  String
  status      String
  description String
  location    String?
  eventAt     DateTime
  createdAt   DateTime @default(now())
  Firm        Firm     @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  dispatch    Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([dispatchId, eventAt])
}

model ExpenseTag {
  id           String                 @id @default(cuid())
  FirmId       String
  name         String                 @unique
  color        String                 @default("#94a3b8")
  createdAt    DateTime               @default(now())
  Firm         Firm                   @relation(fields: [FirmId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]
}

model FinancialTransaction {
  id               String              @id @default(cuid())
  FirmId           String
  type             TxType
  status           TxStatus            @default(PENDING)
  source           TxSource            @default(CASH)
  amount           Float
  currency         String              @default("TRY")
  description      String
  reference        String?
  receiptUrl       String?
  tagId            String?
  currentAccountId String?
  transactionDate  DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  reconciliation   BankReconciliation?
  auditLogs        FinanceAuditLog[]
