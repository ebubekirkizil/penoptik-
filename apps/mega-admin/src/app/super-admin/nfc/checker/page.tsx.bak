"use client";

import { useEffect, useState } from "react";
import { useSearchParams } from "next/navigation";

export default function CardCheckerPage() {
  const searchParams = useSearchParams();
  const scannedId = searchParams.get("scanned");
  
  const [cardStatus, setCardStatus] = useState<any>(null);
  const [loading, setLoading] = useState(false);

  // Set the cookie when this page is open
  useEffect(() => {
    // 1 saatlik geçici admin kontrol çerezi
    document.cookie = "card_checker_mode=true; path=/; max-age=3600";
    
    return () => {
      // Sayfadan çıkınca cookie silinir
      document.cookie = "card_checker_mode=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT";
    };
  }, []);

  // Eğer kart okutulup bu sayfaya yönlendirildiyse API'dan durumunu çek
  useEffect(() => {
    if (scannedId) {
      setLoading(true);
      // Dummy Fetch for Demo - Normalde /api/admin/nfc/check?id=023 gibi bir endpoint'e gidilir
      setTimeout(() => {
        setCardStatus({
          id: scannedId,
          type: scannedId.startsWith("B") ? "CUSTOM (Bireysel B2C)" : "STOCK (Kurumsal)",
          status: "BOŞTA (Kullanılmıyor)", // Veya DOLU (Kime ait olduğu)
          isActive: true
        });
        setLoading(false);
      }, 500);
    }
  }, [scannedId]);

  return (
    <div className="p-8 max-w-4xl mx-auto space-y-8">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold text-gray-900">NFC Card Checker</h1>
          <p className="text-gray-500 mt-2">Bu sayfa açıkken telefonunuza NFC kartları okutabilirsiniz. Sistem yönlendirme yapmak yerine kart bilgilerini buraya düşürecektir.</p>
        </div>
        <div className="px-4 py-2 bg-green-100 text-green-800 rounded-full text-sm font-bold animate-pulse flex items-center gap-2">
          <div className="w-2 h-2 rounded-full bg-green-500"></div>
          Tarama Modu Aktif
        </div>
      </div>

      <div className="bg-white border border-gray-200 rounded-2xl p-12 text-center shadow-sm">
        <div className="w-24 h-24 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg className="w-10 h-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <h3 className="text-xl font-medium text-gray-900">Kart Bekleniyor...</h3>
        <p className="text-gray-500 mt-2">Cihazınızı deponuzdaki fiziksel karta yaklaştırın.</p>
      </div>

      {/* Modal - Kart okunduğunda çıkar */}
      {scannedId && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 relative">
            <button 
              onClick={() => window.location.href = '/super-admin/nfc/checker'}
              className="absolute top-4 right-4 text-gray-400 hover:text-gray-600"
            >
              Kapat
            </button>
            
            <h3 className="text-2xl font-bold text-gray-900 mb-6">Kart Bilgisi</h3>
            
            {loading ? (
              <div className="py-8 text-center text-gray-500">Sorgulanıyor...</div>
            ) : cardStatus ? (
              <div className="space-y-4">
                <div className="flex justify-between items-center py-3 border-b border-gray-100">
                  <span className="text-gray-500">Seri Numarası</span>
                  <span className="font-mono font-bold text-lg">{cardStatus.id}</span>
                </div>
                <div className="flex justify-between items-center py-3 border-b border-gray-100">
                  <span className="text-gray-500">Kart Tipi</span>
                  <span className="font-medium text-gray-900">{cardStatus.type}</span>
                </div>
                <div className="flex justify-between items-center py-3 border-b border-gray-100">
                  <span className="text-gray-500">Durum</span>
                  <span className="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-bold">
                    {cardStatus.status}
                  </span>
                </div>
                <div className="flex justify-between items-center py-3">
                  <span className="text-gray-500">Sistem Erişimi</span>
                  <span className={`font-bold ${cardStatus.isActive ? 'text-green-600' : 'text-red-600'}`}>
                    {cardStatus.isActive ? 'Açık (Aktif)' : 'Kapalı (Kill-Switch)'}
                  </span>
                </div>
                
                <div className="mt-8">
                  <button 
                    onClick={() => window.location.href = '/super-admin/nfc/checker'}
                    className="w-full bg-gray-900 text-white py-3 rounded-xl font-medium hover:bg-gray-800"
                  >
                    Yeni Kart Okut
                  </button>
                </div>
              </div>
            ) : null}
          </div>
        </div>
      )}
    </div>
  );
}
