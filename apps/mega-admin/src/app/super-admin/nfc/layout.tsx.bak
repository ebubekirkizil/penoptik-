"use client";

import { useState } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";
import { LayoutDashboard, CreditCard, Users, Menu, X, ScanLine } from "lucide-react";

export default function SuperAdminNfcLayout({ children }: { children: React.ReactNode }) {
  const pathname = usePathname();
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

  const links = [
    { href: "/super-admin/nfc", label: "Genel Bakış", icon: <LayoutDashboard size={20} /> },
    { href: "/super-admin/nfc/cards", label: "Kart Yönetimi", icon: <CreditCard size={20} /> },
    { href: "/super-admin/nfc/users", label: "Müşteri Yönetimi", icon: <Users size={20} /> },
    { href: "/super-admin/nfc/checker", label: "Kart Tarayıcı", icon: <ScanLine size={20} /> },
  ];

  return (
    <div className="min-h-screen bg-gray-50 flex flex-col md:flex-row">
      
      {/* Mobile Top Bar */}
      <div className="md:hidden bg-gray-900 text-white p-4 flex items-center justify-between sticky top-0 z-50 shadow-md">
        <div className="flex items-center gap-2 font-bold text-lg">
          <ScanLine className="text-blue-400" />
          NFC Yönetimi
        </div>
        <button onClick={() => setMobileMenuOpen(!mobileMenuOpen)} className="p-2 bg-gray-800 rounded-lg">
          {mobileMenuOpen ? <X size={24} /> : <Menu size={24} />}
        </button>
      </div>

      {/* Mobile Dropdown Menu */}
      {mobileMenuOpen && (
        <div className="md:hidden fixed inset-x-0 top-[68px] bg-gray-900 text-white z-40 border-t border-gray-800 shadow-xl pb-4">
          <nav className="flex flex-col p-2 space-y-1">
            {links.map((link) => {
              const isActive = pathname === link.href;
              return (
                <Link 
                  key={link.href} 
                  href={link.href}
                  onClick={() => setMobileMenuOpen(false)}
                  className={`flex items-center gap-3 px-4 py-3 rounded-xl transition-colors ${
                    isActive ? "bg-blue-600 text-white font-bold" : "text-gray-300 hover:bg-gray-800 hover:text-white"
                  }`}
                >
                  {link.icon}
                  {link.label}
                </Link>
              );
            })}
          </nav>
        </div>
      )}

      {/* Desktop Sidebar */}
      <aside className="hidden md:flex w-72 flex-col bg-gray-900 text-white border-r border-gray-800 min-h-screen sticky top-0">
        <div className="p-6 border-b border-gray-800 flex items-center gap-3">
          <div className="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center shadow-lg shadow-blue-900/50">
            <ScanLine size={20} className="text-white" />
          </div>
          <div>
            <h1 className="font-bold text-xl leading-none tracking-tight">NFC CRM</h1>
            <p className="text-blue-400 text-xs mt-1 font-medium tracking-wide uppercase">Mega Admin</p>
          </div>
        </div>
        
        <nav className="flex-1 p-4 space-y-2">
          {links.map((link) => {
            const isActive = pathname === link.href;
            return (
              <Link 
                key={link.href} 
                href={link.href}
                className={`flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 ${
                  isActive 
                    ? "bg-blue-600 text-white font-bold shadow-md" 
                    : "text-gray-400 hover:bg-gray-800 hover:text-white"
                }`}
              >
                {link.icon}
                {link.label}
              </Link>
            );
          })}
        </nav>
        
        <div className="p-4 border-t border-gray-800">
          <Link href="/admin" className="flex items-center justify-center gap-2 w-full py-3 text-sm text-gray-400 hover:text-white hover:bg-gray-800 rounded-xl transition-colors">
            Ana Panele Dön
          </Link>
        </div>
      </aside>

      {/* Main Content Area */}
      <main className="flex-1 w-full max-w-full overflow-x-hidden">
        {children}
      </main>

    </div>
  );
}
