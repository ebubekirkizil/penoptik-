import { db } from "@impecta/database";
import { Plus, Search, ShieldOff, ShieldCheck, Link as LinkIcon, AlertTriangle } from "lucide-react";
import Link from "next/link";
import GenerateCardsButton from "./GenerateCardsButton";

export const revalidate = 0;

export default async function NfcCardsManagementPage() {
  // En son oluşturulan 50 kartı listele
  let cards: any[] = [];
  try {
    cards = await db.nfcCard.findMany({
      take: 50,
      orderBy: { createdAt: 'desc' },
      include: {
        user: {
          include: { nfcProfile: true }
        }
      }
    });
  } catch (error) {
    console.error("NFC Card query error:", error);
  }

  return (
    <div className="p-4 md:p-8 max-w-7xl mx-auto space-y-6">
      
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 className="text-2xl md:text-3xl font-bold text-gray-900">Kart Yönetimi</h1>
          <p className="text-gray-500 mt-1">Sistemdeki tüm NFC kartlarını (Stok & B2C) listeleyin ve yönetin.</p>
        </div>
        <div className="flex gap-2 w-full sm:w-auto">
          <button className="flex-1 sm:flex-none bg-blue-50 text-blue-700 hover:bg-blue-100 px-4 py-2 rounded-lg font-medium transition-colors border border-blue-200">
            Dışa Aktar
          </button>
          <GenerateCardsButton />
        </div>
      </div>

      {/* Arama ve Filtreleme */}
      <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm flex flex-col sm:flex-row gap-4">
        <div className="relative flex-1">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" />
          <input 
            type="text" 
            placeholder="Seri no veya müşteri ara..." 
            className="w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all"
          />
        </div>
        <select className="bg-gray-50 border border-gray-200 rounded-lg px-4 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option>Tüm Tipler</option>
          <option>Stok (Kurumsal)</option>
          <option>B2C (Bireysel)</option>
        </select>
        <select className="bg-gray-50 border border-gray-200 rounded-lg px-4 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option>Tüm Durumlar</option>
          <option>Aktif Kartlar</option>
          <option>İptal Edilenler</option>
          <option>Boş Kartlar</option>
        </select>
      </div>

      {/* Mobil Uyumlu Kart Listesi (Tablo / Card Hybrid) */}
      <div className="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        
        {/* Masaüstü Tablo Başlıkları */}
        <div className="hidden md:grid grid-cols-12 gap-4 p-4 bg-gray-50 border-b border-gray-200 font-bold text-gray-500 text-sm">
          <div className="col-span-2">Seri No</div>
          <div className="col-span-2">Tip</div>
          <div className="col-span-4">Atanan Müşteri</div>
          <div className="col-span-2">Durum</div>
          <div className="col-span-2 text-right">İşlem</div>
        </div>

        {/* Liste Elemanları */}
        <div className="divide-y divide-gray-100">
          {cards.map((card) => (
            <div key={card.id} className="grid grid-cols-1 md:grid-cols-12 gap-4 p-4 items-center hover:bg-gray-50 transition-colors">
              
              {/* Seri No */}
              <div className="col-span-2 flex items-center justify-between md:block">
                <span className="md:hidden text-xs font-bold text-gray-400 uppercase">Seri No</span>
                <span className="font-mono font-bold text-gray-900">{card.serialCode}</span>
              </div>

              {/* Tip */}
              <div className="col-span-2 flex items-center justify-between md:block mt-2 md:mt-0">
                <span className="md:hidden text-xs font-bold text-gray-400 uppercase">Tip</span>
                <span className={`inline-flex px-2.5 py-0.5 rounded-full text-xs font-bold ${
                  !card.user ? 'bg-purple-100 text-purple-800' : 'bg-orange-100 text-orange-800'
                }`}>
                  {!card.user ? 'STOK' : 'MÜŞTERİ'}
                </span>
              </div>

              {/* Müşteri */}
              <div className="col-span-4 flex flex-col mt-2 md:mt-0">
                <span className="md:hidden text-xs font-bold text-gray-400 uppercase mb-1">Müşteri</span>
                {card.user?.nfcProfile ? (
                  <div className="flex flex-col">
                    <span className="font-bold text-gray-900">{card.user.nfcProfile.name}</span>
                    <span className="text-xs text-gray-500 truncate">{card.user.email}</span>
                  </div>
                ) : (
                  <span className="text-gray-400 italic font-medium">Atanmamış (Boşta)</span>
                )}
              </div>

              {/* Durum */}
              <div className="col-span-2 flex items-center justify-between md:block mt-2 md:mt-0">
                <span className="md:hidden text-xs font-bold text-gray-400 uppercase">Durum</span>
                {card.isActive ? (
                  <span className="inline-flex items-center gap-1 text-green-600 font-bold text-sm">
                    <ShieldCheck size={16} /> Aktif
                  </span>
                ) : (
                  <span className="inline-flex items-center gap-1 text-red-600 font-bold text-sm">
                    <ShieldOff size={16} /> İptal (Kill)
                  </span>
                )}
              </div>

              {/* İşlemler */}
              <div className="col-span-12 md:col-span-2 flex justify-end gap-2 mt-4 md:mt-0 pt-4 md:pt-0 border-t md:border-0 border-gray-100">
                {!card.user && card.isActive && (
                  <button className="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="Manuel Ata">
                    <LinkIcon size={18} />
                  </button>
                )}
                <button 
                  className={`p-2 rounded-lg transition-colors ${
                    card.isActive ? "text-red-500 hover:bg-red-50" : "text-green-600 hover:bg-green-50"
                  }`} 
                  title={card.isActive ? "Kill-Switch (İptal Et)" : "Yeniden Aktifleştir"}
                >
                  {card.isActive ? <ShieldOff size={18} /> : <AlertTriangle size={18} />}
                </button>
              </div>

            </div>
          ))}
          
          {cards.length === 0 && (
            <div className="p-12 text-center text-gray-500">
              Henüz sistemde hiç kart bulunmuyor.
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
